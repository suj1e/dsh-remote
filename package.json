{
  "name": "dsh-remote",
  "version": "0.1.0",
  "description": "Mobile remote access for DeepSeek Harness: LAN HTTP+WebSocket bridge for a paired iOS client",
  "type": "module",
  "main": "./lib/index.cjs",
  "types": "./lib/index-Bx7MRbxR.d.cts",
  "exports": {
    ".": "./lib/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/fix-dts-name.mjs",
    "test": "node --test --experimental-strip-types test/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote",
    "mobile"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@rolldown/binding-darwin-arm64": "1.2.10",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "tsdown": "^0.12.0",
    "typescript": "^5.7.0"
  },
  "module": "./lib/index.js"
}
